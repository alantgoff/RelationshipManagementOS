# Postgres connection (required)
DATABASE_URL=postgres://rmos:rmos@localhost:5432/rmos

# Clerk (required in production; optional in development)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Development-only fallback user when Clerk keys are absent
DEV_USER_ID=dev-user
# Set to 1 only for e2e runs against a production build without Clerk. Never in real deploys.
# ALLOW_DEV_AUTH=1
