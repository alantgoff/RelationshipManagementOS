# Postgres connection (required)
DATABASE_URL=postgres://rmos:rmos@localhost:5432/rmos

# Clerk (required in production; optional in development)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Development-only fallback user when Clerk keys are absent
DEV_USER_ID=dev-user
# Set to 1 only for e2e runs against a production build without Clerk. Never in real deploys.
# ALLOW_DEV_AUTH=1

# App-level encryption for tokens and message bodies: openssl rand -base64 32
RMOS_ENCRYPTION_KEY=

# Live agent model (OpenAI-compatible). Primary serves your fine-tuned adapter
# (e.g. Tinker sampling); fallback serves the base model (e.g. OpenRouter).
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

# iMessage via Sendblue
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET=
SENDBLUE_SIGNING_SECRET=
SENDBLUE_FROM_NUMBER=
# Your own iPhone number, for npm run check:sendblue
OWNER_PHONE=

# Scheduled tick (/api/cron/tick): any long random string; also set as the
# CRON_SECRET repository secret for .github/workflows/agent-cron.yml
CRON_SECRET=

# Voice notes: OpenAI-compatible /audio/transcriptions (e.g. Groq or DeepInfra)
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Images: OpenAI-compatible vision chat model
VISION_PRIMARY_BASE_URL=
VISION_PRIMARY_API_KEY=
VISION_PRIMARY_MODEL=
